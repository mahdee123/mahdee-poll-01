PORT=4000
NODE_ENV=development

# System database (holds Company + User accounts). Required.
SYSTEM_MONGODB_URI=mongodb://127.0.0.1:27017/pool_system

# Optional: DB URI for the auto-created "Default Pool" company on first boot.
# If unset, it's derived from SYSTEM_MONGODB_URI automatically (same host,
# database name swapped) - only set this if you need it on a different host.
# DEFAULT_COMPANY_MONGO_URI=mongodb://127.0.0.1:27017/raya_pool_default

# Comma-separated list of allowed frontend origins (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173

# Seeded on first boot only (when the User collection is empty). Rotate the
# password after first login - restarts will NOT reset it.
ADMIN_EMAIL=admin@raya.com
ADMIN_PASSWORD=admin123

# Required in production (server refuses to boot without it). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=super-secret-key
JWT_EXPIRY=12h

# Optional: cap on cached per-company DB connections (default 50).
# MAX_COMPANY_DB_CONNECTIONS=50
